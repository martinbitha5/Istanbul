{
  "expo": {
    "name": "Istanbul Livreur",
    "slug": "istanbul-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "istanbuldriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#100D0B",
    "primaryColor": "#E5431C",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.istanbulfastfood.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position permet au client et au restaurant de suivre la livraison.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Le suivi en arrière-plan permet de continuer à partager votre position pendant une course, écran éteint.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "cd.istanbulfastfood.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet au client de suivre sa livraison.",
          "locationAlwaysAndWhenInUsePermission": "Permet de continuer le suivi pendant une course, même écran éteint.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      ["expo-notifications", { "color": "#E5431C" }],
      ["expo-splash-screen", { "backgroundColor": "#100D0B" }],
      "@sentry/react-native"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
