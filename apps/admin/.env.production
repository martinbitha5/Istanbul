# Configuration de production du dashboard.
#
# Ces deux valeurs sont PUBLIQUES par conception : la clé anon est destinée à
# être embarquée dans le bundle navigateur, et toute la sécurité repose sur la
# Row Level Security côté PostgreSQL — pas sur le secret de cette clé.
#
# Next.js inline les variables NEXT_PUBLIC_* au moment du build : elles doivent
# donc être disponibles à la compilation, d'où ce fichier plutôt qu'une
# configuration d'environnement Vercel.
#
# La clé service_role, elle, ne doit JAMAIS apparaître ici.

NEXT_PUBLIC_SUPABASE_URL=https://mvwmbjabiybbzfoejahc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im12d21iamFiaXliYnpmb2VqYWhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5OTI1ODAsImV4cCI6MjEwMjU2ODU4MH0.8Xu9xlU99bspheKwJ9OIgd1J6uLxuEwpCNh70mNaNug
NEXT_PUBLIC_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
