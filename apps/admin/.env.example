# Copier vers apps/admin/.env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Pas de NEXT_PUBLIC_RESTAURANT_ID : le dashboard lit l'unique ligne de la
# table `restaurants` au chargement (fn_dashboard_bootstrap). Un identifiant en
# dur dans l'environnement, c'était un dashboard silencieusement vide le jour
# où la variable manquait au déploiement.

# Uniquement pour les scripts serveur — jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
