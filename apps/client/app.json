{
  "expo": {
    "name": "Istanbul Fast Food",
    "slug": "istanbul-fast-food",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "istanbul",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FFFBF7",
    "primaryColor": "#E5431C",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.istanbulfastfood.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position permet de calculer les frais de livraison et de suivre votre commande.",
        "NSCameraUsageDescription": "Pour prendre une photo de profil.",
        "NSPhotoLibraryUsageDescription": "Pour choisir une photo de profil.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "cd.istanbulfastfood.client",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet de calculer les frais de livraison et de suivre votre commande."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E5431C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5431C",
          "dark": {
            "backgroundColor": "#100D0B"
          }
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
