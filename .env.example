# ---------------------------------------------------------------------------
# Istanbul Fast Food — variables d'environnement
# Copier vers .env (racine) puis vers apps/*/.env si besoin.
# ---------------------------------------------------------------------------

# --- Supabase (partagé) ----------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Ne JAMAIS exposer côté mobile / navigateur. Uniquement Edge Functions & scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Apps mobiles (Expo) ---------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
EXPO_PUBLIC_ENV=development

# --- Dashboard admin (Next.js) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# --- Notifications push ----------------------------------------------------
EXPO_ACCESS_TOKEN=
# L'URL du projet et la clé anon doivent aussi être renseignées côté base :
#   update public.app_config set value='https://<ref>.supabase.co' where key='edge_base_url';
#   update public.app_config set value='<clé anon>'                where key='edge_notify_key';
# (fait automatiquement pour le projet de prod ; requis après un nouveau déploiement)

# --- Sentry (vide = désactivé) ---------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Restaurant --------------------------------------------------------------
# Istanbul est le seul établissement. Les apps mobiles lisent cet identifiant
# (EXPO_PUBLIC_RESTAURANT_ID) ; le dashboard, lui, résout l'unique ligne de la
# table `restaurants` et n'a rien à configurer.
DEFAULT_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
