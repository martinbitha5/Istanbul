{
  "name": "istanbul-fast-food",
  "private": true,
  "version": "0.1.0",
  "description": "Istanbul Fast Food — plateforme de commande et de livraison (Kinshasa)",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "client": "pnpm --filter @istanbul/client start",
    "driver": "pnpm --filter @istanbul/driver start",
    "admin": "pnpm --filter @istanbul/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "supabase test db",
    "clean": "turbo run clean && rimraf node_modules",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql}\""
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.3",
    "typescript": "~5.9.2"
  }
}
